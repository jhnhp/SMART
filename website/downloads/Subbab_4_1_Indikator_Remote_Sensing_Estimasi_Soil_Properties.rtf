\pard\intbl\fs15 Soil-Adjusted Vegetation Index (SAVI)\cell
\pard\intbl\fs15 (1+L)(NIR-Red)/(NIR+Red+L), L=0,5\cell
\pard\intbl\fs15 Menambahkan faktor koreksi latar tanah untuk mengurangi bias kecerahan tanah ketika tajuk belum menutup rapat.\cell
